54-116-113-17.sslip.io {
    # 요청 본문 크기 제한: 사진 한 장(300KB)과 JSON 요청을 넉넉히 덮는 2MB. 넘으면 앱에 닿기 전에 413
    # (제한이 없으면 큰 본문 하나로 메모리 2GB 서버가 멈출 수 있음. API 보안 검사 4묶음)
    request_body {
        max_size 2MB
    }

    # 보안 헤더 (화면·API 모든 응답에 붙음)
    header {
        # 1년 동안 이 주소는 HTTPS로만 열게 함 (이 주소 하나에만, 하위 주소는 해당 없음)
        Strict-Transport-Security "max-age=31536000"
        # 다른 사이트가 우리 화면을 iframe으로 감싸 속이는 것(클릭재킹)을 막음
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
        # 파일 형식을 브라우저가 멋대로 추측하지 않게 함
        X-Content-Type-Options "nosniff"
        # 다른 사이트로 이동할 때 우리 주소의 경로(화면 이름 등)는 넘기지 않음
        Referrer-Policy "strict-origin-when-cross-origin"
        # 쓰지 않는 카메라·마이크·위치 권한은 아예 막음 (사진 올리기는 파일 선택이라 영향 없음)
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # 서버 프로그램 이름(Caddy)을 숨김
        -Server
    }

    @api path /v1/* /docs /docs/* /openapi.json /healthcheck /static/* /media/*
    handle @api {
        reverse_proxy fastapi:8000
    }
    handle {
        root * /srv/frontend
        # 앱(Capacitor) 프로젝트 파일은 화면이 아니라서 밖으로 내보내지 않음 (API 보안 검사)
        @notweb path /android/* /ios/* /package.json /package-lock.json /capacitor.config.json
        respond @notweb 404
        # 화면 파일(html·js·css)은 쓸 때마다 바뀌었는지 서버에 확인하게 함(no-cache).
        # 안 바뀌었으면 304로 짧게 끝나고, 배포 직후 예전 파일을 써서 화면이 깨지는 일을 막음 (10/21 팀 요청)
        @pages path / *.html *.js *.css
        header @pages Cache-Control "no-cache"
        file_server
    }
}
