# 복사해서 .env 로 쓴다. .env 는 커밋 금지.
# cp .env.example .env

DB_HOST=localhost
DB_PORT=3306
DB_USER=paeon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_NAME=paeon

# 관리자 화면(admin.html)을 쓸 수 있는 계정 이메일 (쉼표로 구분, 비우면 아무도 못 씀)
ADMIN_EMAILS=

# 운영 알림(신고 누적 자동 숨김 등)을 받을 디스코드 웹후크 주소. 비우면 보내지 않음. 실제 값은 .env에만 적고 커밋 금지
ADMIN_ALERT_WEBHOOK=
