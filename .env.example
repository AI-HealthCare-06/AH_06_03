# 복사해서 .env 로 쓴다. .env 는 커밋 금지.
# cp .env.example .env

DB_HOST=localhost
DB_PORT=3306
DB_USER=paeon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_NAME=paeon

# 관리자 화면(admin.html)을 쓸 수 있는 계정 이메일 (쉼표로 구분, 비우면 아무도 못 씀)
ADMIN_EMAILS=

# 같은 IP에서 15분 안에 이만큼 로그인을 틀리면 잠시 막음 (기본 50). 체험 안내처럼 여러 명이 같은 와이파이를 쓰는 날엔 늘림
# LOGIN_MAX_FAILS_PER_IP=50

# 운영 알림(신고 누적 자동 숨김 등)을 받을 디스코드 웹후크 주소. 비우면 보내지 않음. 실제 값은 .env에만 적고 커밋 금지
ADMIN_ALERT_WEBHOOK=
# 지인 체험 전용. 1이면 3일치 챌린지 기록 뒤 나머지 4주를 채우고 사이클을 끝낸다. 정식 배포에서는 비워 둔다.
# DEMO_AUTOFILL=1
